# ---------------------------------------------------------------------------
# Playwright Automation Base - 환경변수 예시
#
# 사용법:  이 파일을 .env 로 복사한 뒤 필요한 값만 채웁니다.
#   Windows : copy .env.example .env
#   Linux   : cp .env.example .env
#
# .env 는 .gitignore 에 등록되어 있어 Git 에 올라가지 않습니다.
#
# ★ 중요 ★
#   여기 있는 값은 config/*.yaml 을 "덮어씁니다".
#   그래서 아래 항목은 대부분 주석 처리되어 있습니다.
#   주석을 풀면 환경(dev/staging/prod)과 상관없이 그 값으로 고정됩니다.
#   예) HEADLESS 주석을 풀면 config/dev.yaml 의 headless:false 가 무시됩니다.
#
#   우선순위:  config/default.yaml < config/<env>.yaml < .env < CLI 옵션
# ---------------------------------------------------------------------------

# ===========================================================================
# 필수 - 실행 환경 (dev / staging / prod)
#   이 값만 .env 에서 정하고, 나머지는 config/<env>.yaml 에 맡기는 것을 권장합니다.
# ===========================================================================
ENV=staging

# ===========================================================================
# 민감정보 - 계정 비밀번호 / 토큰
#   config/*.yaml 의 accounts.<role>.password_env 에 적은 이름과 맞춰주세요.
#   CI 에서는 이 값을 Secrets 로 주입합니다.
# ===========================================================================
USER_PASSWORD=
ADMIN_PASSWORD=
API_TOKEN=

# ===========================================================================
# 아래부터는 선택. 필요할 때만 주석을 푸세요.
# ===========================================================================

# ---- 프로젝트 / 대상 URL (보통 config/*.yaml 에 둡니다) ----
# PROJECT_NAME=Example Automation
# BASE_URL=https://example.com
# API_BASE_URL=https://api.example.com

# ---- Browser (chromium / firefox / webkit) ----
#   일회성이면 .env 대신 CLI 를 쓰세요:  pytest --browser=firefox --headed
# BROWSER=chromium
# HEADLESS=true
# SLOW_MO=0

# ---- Timeout (ms) ----
#   주의: 여기를 켜면 prod.yaml 의 더 넉넉한 타임아웃도 이 값으로 덮입니다.
# DEFAULT_TIMEOUT=30000
# NAVIGATION_TIMEOUT=45000
# EXPECT_TIMEOUT=10000

# ---- Viewport ----
# VIEWPORT_WIDTH=1920
# VIEWPORT_HEIGHT=1080

# ---- Retry (기본 0. CI 에서만 1~2 권장) ----
#   일회성이면:  pytest --reruns 1
# RETRIES=0

# ---- Evidence 저장 정책 (always / on-failure / never) ----
#   기본은 on-failure (실패했을 때만 저장). 오타를 내면 실행 시작 시 에러가 납니다.
# SCREENSHOT_MODE=on-failure
# TRACE_MODE=on-failure
# PAGE_HTML_MODE=on-failure
# LOG_MODE=on-failure

# ---- 오래된 artifacts 정리 (실행 시작 시) ----
#   keep_days 가 0 이면 정리하지 않습니다. CI 처럼 매번 새 머신이면 0 이 낫습니다.
#   keep_min_runs 는 기간이 지났어도 최근 N개는 남기는 안전장치입니다.
# ARTIFACTS_KEEP_DAYS=14
# ARTIFACTS_KEEP_MIN_RUNS=5

# ---- 기타 ----
# LOCALE=ko-KR
# TIMEZONE=Asia/Seoul
# IGNORE_HTTPS_ERRORS=false

# ---- 리포트 메타정보 ----
# 테스트 대상 앱의 버전. 리포트에 표시됩니다. (선택)
# APP_VERSION=v2.14.3

# 실행자 이름을 리포트에 남기지 않으려면 false (선택)
# SHOW_TRIGGERED_BY=true

# 실행이 끝나면 report.html 을 브라우저로 자동으로 엽니다. 기본은 켜짐입니다.
#   CI 환경변수(CI / GITHUB_ACTIONS / JENKINS_URL 등)가 잡히거나 -n 병렬 실행이면
#   기본값이 자동으로 꺼집니다. 여기에 true 를 직접 쓰면 CI 에서도 열립니다.
#   일회성으로 켜고 끄기:  pytest --open-report  /  pytest --no-open-report
# OPEN_REPORT=true
