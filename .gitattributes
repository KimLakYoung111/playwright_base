# ---------------------------------------------------------------------------
# 줄바꿈 통일
#   Windows / Linux / CI 를 오가는 프로젝트라 저장소에는 LF 로 통일합니다.
#   이렇게 해두지 않으면 사람마다 줄바꿈이 달라져 diff 가 파일 전체로 잡힙니다.
# ---------------------------------------------------------------------------
* text=auto eol=lf

# ---------------------------------------------------------------------------
# 바이너리 - 절대 변환하면 안 되는 파일
#   sample.pdf 는 내용이 대부분 ASCII 라 Git 이 텍스트로 오해합니다.
#   변환되면 xref 오프셋이 틀어져 PDF 가 깨집니다.
# ---------------------------------------------------------------------------
*.pdf   -text
*.png   -text
*.jpg   -text
*.jpeg  -text
*.gif   -text
*.ico   -text
*.zip   -text
*.woff  -text
*.woff2 -text

# ---------------------------------------------------------------------------
# GitHub 언어 통계에서 제외 (리포트 템플릿이 프로젝트 언어로 잡히지 않게)
# ---------------------------------------------------------------------------
reporting/templates/*.html linguist-vendored
